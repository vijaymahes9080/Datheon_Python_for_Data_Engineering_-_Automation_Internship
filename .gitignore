# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Logs and runtime locks (preserve folder with .gitkeep)
logs/*.log
logs/*.lock

# Local secrets & environment files
.env
.env.local

# Database temporary journals
database/*.db-journal
database/*.db-wal
database/*.db-shm

# OS generated files
.DS_Store
Thumbs.db

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
