# ==============================================================================
# StreamForge Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure local values as needed.
# Secrets are NEVER committed to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=StreamForge

# Storage Directories (Relative to streamforge_etl or absolute)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_FIXTURES_DIR=data/fixtures
REPORTS_DIR=reports
LOGS_DIR=logs

# Database Configuration (Default: SQLite local zero-setup)
DATABASE_DIALECT=sqlite
SQLITE_DB_PATH=database/streamforge.db

# Optional PostgreSQL Configuration (Used when DATABASE_DIALECT=postgresql)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streamforge_db
# POSTGRES_URL=postgresql+psycopg2://postgres:secret@localhost:5432/streamforge_db

# Web Extraction Pacing & Limits
SCRAPER_DEFAULT_DELAY_SEC=1.0
SCRAPER_REQUEST_TIMEOUT_SEC=10
SCRAPER_MAX_RETRIES=3
SCRAPER_BACKOFF_FACTOR=1.5
SCRAPER_MAX_PAGES=5
SCRAPER_MAX_RECORDS=200
SCRAPER_USER_AGENT=StreamForge-DataExtractor/1.0 (+https://github.com/vijaymahes9080/Datheon_Python_for_Data_Engineering_-_Automation_Internship)

# Pipeline Automation & Alerting
ALERT_CONSOLE_ENABLED=true
ALERT_SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENT=

ALERT_WEBHOOK_ENABLED=false
WEBHOOK_URL=

# Scheduling Configuration
PIPELINE_SCHEDULE_INTERVAL_MINUTES=60
PIPELINE_SCHEDULE_TIMEZONE=UTC
